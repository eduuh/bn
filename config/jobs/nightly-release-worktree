#!/bin/sh

# Worktree lifecycle for nightly-release. Kept separate so checkout selection and dirty-tree
# safety can be regression-tested without building or publishing binaries.

bn_nightly_release_path_from_porcelain() {
  awk '
    /^worktree / {
      path = substr($0, 10)
      if (path ~ /\/bn\/_release-main$/) {
        release = path
      }
      if (root == "" && path ~ /\/bn\/[^/]+$/) {
        root = path
        sub(/\/[^/]+$/, "", root)
      }
    }
    END {
      if (release != "") {
        print release
      } else if (root != "") {
        print root "/_release-main"
      }
    }
  '
}

bn_nightly_install_anchor() {
  (CDPATH= cd -- "$HOME/.config/bn/repo" 2>/dev/null && pwd -P)
}

bn_nightly_resolve_worktree() {
  if [ -n "${BN_MAIN_WORKTREE:-}" ]; then
    # CI passes an explicit checkout. Local cron runs should still prefer the dedicated
    # release worktree unless the override is the real GitHub Actions checkout.
    if [ "${GITHUB_ACTIONS:-false}" = "true" ]; then
      printf '%s\n' "$BN_MAIN_WORKTREE"
      return 0
    fi

    if [ -e "$BN_MAIN_WORKTREE/.git" ]; then
      bn_nightly_branch=$(git -C "$BN_MAIN_WORKTREE" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
      case "$bn_nightly_branch" in
        main)
          printf '%s\n' "$BN_MAIN_WORKTREE"
          return 0
          ;;
      esac
    fi
  fi

  bn_nightly_anchor=$(bn_nightly_install_anchor 2>/dev/null || true)
  if [ -n "$bn_nightly_anchor" ]; then
    bn_nightly_porcelain=$(git -C "$bn_nightly_anchor" worktree list --porcelain 2>/dev/null || true)
    bn_nightly_candidate=$(printf '%s\n' "$bn_nightly_porcelain" |
      bn_nightly_release_path_from_porcelain)
    if [ -n "$bn_nightly_candidate" ]; then
      printf '%s\n' "$bn_nightly_candidate"
      return 0
    fi
  fi

  printf '%s\n' "$HOME/projects/worktree/bn/_release-main"
}

bn_nightly_prepare_worktree() {
  bn_nightly_anchor=$(bn_nightly_install_anchor 2>/dev/null || true)
  bn_nightly_repo=$(bn_nightly_resolve_worktree)
  bn_nightly_managed=0
  case "$bn_nightly_repo" in
    */_release-main) bn_nightly_managed=1 ;;
  esac

  if [ ! -e "$bn_nightly_repo/.git" ]; then
    if [ -n "${BN_MAIN_WORKTREE:-}" ]; then
      printf '%s\n' \
        "nightly-release: BN_MAIN_WORKTREE is not a git worktree ($bn_nightly_repo)" >&2
      return 1
    fi
    if [ -z "$bn_nightly_anchor" ]; then
      printf '%s\n' \
        "nightly-release: cannot create $bn_nightly_repo without the bn install anchor" >&2
      return 1
    fi
    if [ -e "$bn_nightly_repo" ]; then
      printf '%s\n' \
        "nightly-release: dedicated checkout path is occupied ($bn_nightly_repo)" >&2
      return 1
    fi

    mkdir -p "$(dirname "$bn_nightly_repo")" || return 1
    git -C "$bn_nightly_anchor" fetch --quiet origin main ||
      {
        printf '%s\n' "nightly-release: cannot fetch origin/main" >&2
        return 1
      }
    git -C "$bn_nightly_anchor" worktree add --detach "$bn_nightly_repo" origin/main \
      >/dev/null 2>&1 ||
      {
        printf '%s\n' \
          "nightly-release: cannot create dedicated checkout ($bn_nightly_repo)" >&2
        return 1
      }
    bn_nightly_managed=1
  fi

  if [ -n "$(git -C "$bn_nightly_repo" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    printf '%s\n' \
      "nightly-release: $bn_nightly_repo has tracked changes — refusing to overwrite them" >&2
    return 1
  fi

  git -C "$bn_nightly_repo" fetch --quiet origin main ||
    {
      printf '%s\n' "nightly-release: cannot fetch origin/main — refusing a stale release" >&2
      return 1
    }

  bn_nightly_branch=$(git -C "$bn_nightly_repo" rev-parse --abbrev-ref HEAD 2>/dev/null) ||
    {
      printf '%s\n' "nightly-release: cannot read HEAD in $bn_nightly_repo" >&2
      return 1
    }
  case "$bn_nightly_branch" in
    main)
      git -C "$bn_nightly_repo" merge --ff-only --quiet origin/main ||
        {
          printf '%s\n' \
            "nightly-release: $bn_nightly_repo cannot fast-forward main to origin/main" >&2
          return 1
        }
      ;;
    HEAD)
      if [ "${GITHUB_ACTIONS:-false}" = "true" ]; then
        bn_nightly_head=$(git -C "$bn_nightly_repo" rev-parse HEAD 2>/dev/null || true)
        if [ -z "${GITHUB_SHA:-}" ] || [ "$bn_nightly_head" != "$GITHUB_SHA" ]; then
          printf '%s\n' \
            "nightly-release: GitHub checkout HEAD does not match GITHUB_SHA" >&2
          return 1
        fi
      elif [ "$bn_nightly_managed" = "1" ]; then
        git -C "$bn_nightly_repo" checkout --detach --quiet origin/main ||
          {
            printf '%s\n' \
              "nightly-release: cannot update dedicated checkout to origin/main" >&2
            return 1
          }
      else
        printf '%s\n' \
          "nightly-release: $bn_nightly_repo is detached and is not the dedicated release checkout" >&2
        return 1
      fi
      ;;
    *)
      printf '%s\n' \
        "nightly-release: $bn_nightly_repo is on '$bn_nightly_branch', not main — skipping" >&2
      return 1
      ;;
  esac

  bn_nightly_head=$(git -C "$bn_nightly_repo" rev-parse HEAD 2>/dev/null || true)
  bn_nightly_remote=$(git -C "$bn_nightly_repo" rev-parse --verify origin/main 2>/dev/null || true)
  if [ -z "$bn_nightly_head" ] || [ "$bn_nightly_head" != "$bn_nightly_remote" ]; then
    printf '%s\n' \
      "nightly-release: $bn_nightly_repo is not at latest origin/main — skipping" >&2
    return 1
  fi

  printf '%s\n' "$bn_nightly_repo"
}
