#!/usr/bin/env bash
# tmux guard — forward every safe command to the real binary, but refuse destructive kill verbs.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
real_tmux="${BN_REAL_TMUX:-$script_dir/tmux.real}"

if [ ! -x "$real_tmux" ]; then
  echo "tmux guard: real tmux binary not found at $real_tmux" >&2
  exit 127
fi

args=("$@")
i=0
while [ "$i" -lt "${#args[@]}" ]; do
  case "${args[$i]}" in
    --)
      i=$((i + 1))
      break
      ;;
    -L|-S|-f)
      i=$((i + 2))
      continue
      ;;
    -2|-C|-q|-u|-v|-V|--help|--version)
      i=$((i + 1))
      continue
      ;;
    -*)
      i=$((i + 1))
      continue
      ;;
    *)
      break
      ;;
  esac
done

verb="${args[$i]:-}"
case "$verb" in
  kill-server|kill-session|kill-window|kill-pane|kill-client)
    echo "tmux guard: refusing destructive command '$verb'" >&2
    exit 1
    ;;
esac

exec "$real_tmux" "$@"
